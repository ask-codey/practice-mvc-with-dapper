@model List<Book>
@{
    ViewData["Title"] = "Books";
}

<h1 class="mb-4">Books</h1>
<p>@Model.Count books</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Title</th>
            <th>Published</th>
            <th class="text-end">Price</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Book book in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@book.BookId">@book.Title</a></td>
                <td>@book.PublishDate.ToString("MMMM d, yyyy")</td>
                <td class="text-end">@book.Price?.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>
