@model List<Book>
@{
    ViewData["Title"] = "Home";
}

<h1 class="display-5 mb-4">Featured Books</h1>

<div id="featured" class="carousel slide bg-body-tertiary rounded mb-4" data-bs-ride="carousel">
    <div class="carousel-inner">
        @for (int i = 0; i < Model.Count; i++)
        {
            Book book = Model[i];
            <div class="carousel-item @(i == 0 ? "active" : "")">
                <div class="p-5 text-center">
                    <h2>@book.Title</h2>
                    <p class="fs-4 text-success fw-bold">@book.Price?.ToString("C")</p>
                    <a class="btn btn-primary" asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId">See the details</a>
                </div>
            </div>
        }
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#featured" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#featured" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<p><a asp-controller="Books" asp-action="Index">Browse every book</a></p>
