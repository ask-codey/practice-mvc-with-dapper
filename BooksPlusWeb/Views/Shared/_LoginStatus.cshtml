@if (User.Identity?.IsAuthenticated == true)
{
    <form method="post" asp-controller="Account" asp-action="Logout" class="d-flex align-items-center gap-2">
        <span class="navbar-text">Hi, @User.Identity.Name</span>
        <button type="submit" class="btn btn-link nav-link">Sign out</button>
    </form>
}
else
{
    <a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a>
}
